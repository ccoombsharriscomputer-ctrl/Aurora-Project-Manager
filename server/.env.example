DATABASE_URL="postgresql://aurora_app:aurora_app_dev_pw@localhost:5432/aurora_pm"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# Optional — only needed for "Create project from a contract (PDF)". Get a key at
# console.anthropic.com. Without it, that one feature returns a friendly 503; everything
# else in the app works fine.
ANTHROPIC_API_KEY=""
# Optional — only needed to show live ticket status on projects with a TeamSupport ticket #
# linked. Without them, that section returns a friendly 503; everything else in the app
# works fine. Find your Org ID under Admin > My Company, and your API Token under
# Admin > Integration > TeamSupport API (you may need to generate one).
TEAMSUPPORT_ORG_ID=""
TEAMSUPPORT_API_TOKEN=""
# Required if your account isn't on TeamSupport's NA1 server (the default). Log into
# TeamSupport normally and check the browser URL — if it's app.teamsupport.com you're on
# NA1 and can leave this blank; if it's app.na2.teamsupport.com (or na3/na4), set this to
# that same origin, e.g. "https://app.na2.teamsupport.com".
TEAMSUPPORT_API_BASE_URL=""
# Optional — where project/task attachments get stored. Without this, files are saved to
# ./uploads on local disk, which is fine for local dev but doesn't survive a redeploy or
# scale-out on most hosts. Set this to move attachments to Azure Blob Storage instead — the
# connection string is under your Storage Account > Access keys in the Azure Portal.
AZURE_STORAGE_CONNECTION_STRING=""
# Optional — defaults to "attachments" if unset. Only used when AZURE_STORAGE_CONNECTION_STRING
# is set; the container is created automatically on first upload if it doesn't already exist.
AZURE_STORAGE_CONTAINER_NAME=""
