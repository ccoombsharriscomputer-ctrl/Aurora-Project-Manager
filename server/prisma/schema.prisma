// binaryTargets pins which platforms' query engine binaries get bundled. Without this,
// `prisma generate` only builds for whatever OS it's currently running on ("native") — fine
// for Render (which builds on Linux in CI) but not when a deploy package is built locally on
// Windows and then shipped to a Linux host (Azure App Service). Both Debian OpenSSL variants
// are listed since Azure's exact base image version isn't something we can inspect directly;
// "native" keeps local Windows dev working as before.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROJECT_LEAD
  MEMBER
  READ_ONLY
}

enum ProjectMemberRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  NA
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  PROJECT_UNARCHIVED
  PROJECT_DELETED
  SUBPROJECT_DELETED
  TASK_CREATED
  TASK_DELETED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  COMMENT_ADDED
  COMMENT_DELETED
  ATTACHMENT_ADDED
  ATTACHMENT_DELETED
  TIME_LOGGED
  FOLLOW_UP_SCHEDULED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum AccentColor {
  BLUE
  GREEN
  PURPLE
  ORANGE
  RED
  TEAL
}

enum Locale {
  EN
  ES
  FR_CA
}

model SoftwareLine {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())

  users                User[]          @relation("UserSoftwareLine")
  activeForUsers       User[]          @relation("UserActiveSoftwareLine")
  projects             Project[]
  projectTypes         ProjectType[]
  checklistItems       ChecklistItem[]
  accessRequests       AccessRequest[]
  activities           Activity[]
  userGrants           UserSoftwareLineGrant[]
}

model User {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  passwordHash        String
  role                UserRole    @default(MEMBER)
  active              Boolean     @default(true)
  theme               ThemeMode   @default(SYSTEM)
  accentColor         AccentColor @default(BLUE)
  locale              Locale      @default(EN)
  softwareLineId      String
  softwareLine        SoftwareLine  @relation("UserSoftwareLine", fields: [softwareLineId], references: [id])
  activeSoftwareLineId String?
  activeSoftwareLine   SoftwareLine? @relation("UserActiveSoftwareLine", fields: [activeSoftwareLineId], references: [id])
  teamSupportUserId   String?
  createdAt           DateTime    @default(now())

  createdProjects   Project[]       @relation("ProjectCreatedBy")
  projectMemberships ProjectMember[]
  createdTasks      Task[]          @relation("TaskCreatedBy")
  assignedTasks     Task[]          @relation("TaskAssignee")
  comments          Comment[]
  attachments       Attachment[]
  timeEntries       TimeEntry[]
  activities        Activity[]
  createdProjectTypes ProjectType[]
  createdSubProjects  SubProject[]
  createdChecklistItems ChecklistItem[]
  createdTaskTemplates  TaskTemplate[]
  decidedAccessRequests AccessRequest[]
  followUps             FollowUp[]
  softwareLineGrants    UserSoftwareLineGrant[]
}

// Grants a Project Lead or Member access to an additional software line beyond their home
// one — they switch into it the same way an admin switches lines, keeping their existing
// role's permissions. Admins need no grants (already unrestricted); Read Only stays locked
// to its home line (no UI ever creates a grant for that role).
model UserSoftwareLineGrant {
  userId         String
  softwareLineId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  softwareLine   SoftwareLine @relation(fields: [softwareLineId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([userId, softwareLineId])
}

model Project {
  id                     String      @id @default(cuid())
  name                   String
  description            String?
  teamSupportTicketNumber String?
  projectTypeId          String
  projectType            ProjectType @relation(fields: [projectTypeId], references: [id])
  softwareLineId         String
  softwareLine           SoftwareLine @relation(fields: [softwareLineId], references: [id])
  createdById            String
  createdBy              User        @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime    @default(now())
  archivedAt             DateTime?

  members    ProjectMember[]
  tasks      Task[]
  subProjects SubProject[]
  activities Activity[]
  attachments Attachment[]
}

model ProjectType {
  id             String   @id @default(cuid())
  name           String
  description    String?
  active         Boolean  @default(true)
  softwareLineId String
  softwareLine   SoftwareLine @relation(fields: [softwareLineId], references: [id])
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  projects Project[]
  tasks    Task[]

  @@unique([softwareLineId, name])
}

model ChecklistItem {
  id             String   @id @default(cuid())
  name           String
  description    String?
  active         Boolean  @default(true)
  softwareLineId String
  softwareLine   SoftwareLine @relation(fields: [softwareLineId], references: [id])
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  subProjects   SubProject[]
  taskTemplates TaskTemplate[]
}

model TaskTemplate {
  id              String        @id @default(cuid())
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  priority        TaskPriority  @default(MEDIUM)
  active          Boolean       @default(true)
  order           Int           @default(0)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
}

model SubProject {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id])
  name            String?
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  tasks Task[]
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Task {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProjectId  String
  subProject    SubProject  @relation(fields: [subProjectId], references: [id], onDelete: Cascade)
  projectTypeId String
  projectType   ProjectType @relation(fields: [projectTypeId], references: [id])
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  order       Int          @default(0)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  completedAt DateTime?
  naReason    String?
  createdById String
  createdBy   User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  comments    Comment[]
  attachments Attachment[]
  timeEntries TimeEntry[]
  activities  Activity[]
  followUps   FollowUp[]
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  // Snapshotted at post time from TeamSupport's "PS - ..." action type catalog, and whether
  // the synced note was posted Public or Private — display-only, doesn't affect anything.
  teamSupportActionType String?
  teamSupportIsPublic   Boolean  @default(false)
  createdAt DateTime @default(now())

  timeEntry TimeEntry?
}

model Attachment {
  id             String   @id @default(cuid())
  taskId         String?
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId     String
  uploader       User     @relation(fields: [uploaderId], references: [id])
  storedFilename String
  originalName   String
  mimeType       String
  size           Int
  createdAt      DateTime @default(now())
}

model TimeEntry {
  id              String    @id @default(cuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  // Set when this entry came from logging hours alongside a comment, so the UI can show the
  // two as one line instead of two separate entries. Null for Start Timer/Stop entries, which
  // have no comment of their own.
  commentId       String?   @unique
  comment         Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  note            String?
  createdAt       DateTime  @default(now())
}

// A calendar reminder to check back on a task — deliberately not a Task itself, so it never
// shows up as an open task in reports, dashboard counts, or a sub-project's board. The
// calendar just shows "Follow up" and links back to `task`.
model FollowUp {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dueDate   DateTime
  createdAt DateTime @default(now())
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  message   String
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  // Captured at log time and never derived through projectId/taskId, so a deleted
  // project's or task's history stays queryable by line even after those FKs go null.
  softwareLineId String
  softwareLine   SoftwareLine @relation(fields: [softwareLineId], references: [id])
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
}

model AccessRequest {
  id             String              @id @default(cuid())
  name           String
  email          String
  message        String?
  status         AccessRequestStatus @default(PENDING)
  softwareLineId String
  softwareLine   SoftwareLine        @relation(fields: [softwareLineId], references: [id])
  createdAt      DateTime            @default(now())
  decidedAt      DateTime?
  decidedById    String?
  decidedBy      User?               @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status])
}
