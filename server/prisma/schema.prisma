// binaryTargets pins which platforms' query engine binaries get bundled. Without this,
// `prisma generate` only builds for whatever OS it's currently running on ("native") — fine
// for Render (which builds on Linux in CI) but not when a deploy package is built locally on
// Windows and then shipped to a Linux host (Azure App Service). Both Debian OpenSSL variants
// are listed since Azure's exact base image version isn't something we can inspect directly;
// "native" keeps local Windows dev working as before.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROJECT_LEAD
  MEMBER
  READ_ONLY
  // Support staff who only use the Ticket Finder desktop program. Blocked from every APM
  // route except /api/auth and /api/ticket-search, and can't sign in to the web app at all.
  TICKET_SEARCH
}

enum ProjectMemberRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  NA
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ASSIGNED
  PROJECT_ARCHIVED
  PROJECT_UNARCHIVED
  PROJECT_DELETED
  SUBPROJECT_DELETED
  TASK_CREATED
  TASK_DELETED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  COMMENT_ADDED
  COMMENT_DELETED
  ATTACHMENT_ADDED
  ATTACHMENT_DELETED
  TIME_LOGGED
  FOLLOW_UP_SCHEDULED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
  MIDNIGHT
  AURORA
  SUNSET
  OCEAN
  FOREST
  PASTEL
  SLATE
  CONTRAST
  GOTHAM
  METROPOLIS
  EMPIRE
  TATOOINE
  HOTH
  GALAXY
}

enum AccentColor {
  BLUE
  GREEN
  PURPLE
  ORANGE
  RED
  TEAL
  INDIGO
  PINK
  CYAN
  GOLD
  LIME
  GRAPHITE
}

enum Locale {
  EN
  ES
  FR_CA
}

model SoftwareLine {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())

  users                User[]          @relation("UserSoftwareLine")
  activeForUsers       User[]          @relation("UserActiveSoftwareLine")
  projects             Project[]
  projectTypes         ProjectType[]
  checklistItems       ChecklistItem[]
  accessRequests       AccessRequest[]
  activities           Activity[]
  userGrants           UserSoftwareLineGrant[]
  accessRequestSubscribers AccessRequestLineSubscription[]
  savedReports         SavedReport[]
}

model User {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  passwordHash        String
  role                UserRole    @default(MEMBER)
  active              Boolean     @default(true)
  theme               ThemeMode   @default(SYSTEM)
  accentColor         AccentColor @default(BLUE)
  locale              Locale      @default(EN)
  // No Settings-page toggle yet — this exists so a future opt-out doesn't need its own
  // migration. Defaults on for everyone.
  emailNotifications  Boolean     @default(true)
  // Only meaningful for role ADMIN. If true (the default, so every existing admin keeps
  // today's behavior until someone explicitly narrows it), this admin is emailed for every
  // new access request regardless of software line. If false, only for lines they're
  // explicitly subscribed to via accessRequestLineSubscriptions.
  accessRequestNotifyAllLines Boolean @default(true)
  softwareLineId      String
  softwareLine        SoftwareLine  @relation("UserSoftwareLine", fields: [softwareLineId], references: [id])
  activeSoftwareLineId String?
  activeSoftwareLine   SoftwareLine? @relation("UserActiveSoftwareLine", fields: [activeSoftwareLineId], references: [id])
  teamSupportUserId   String?
  createdAt           DateTime    @default(now())
  // Self-service "forgot password" — set together when a reset is requested, cleared
  // together the moment it's used (or overwritten by a fresh request, which invalidates
  // whatever was pending before). Only the SHA-256 hash of the token is stored, matching
  // passwordHash's own never-store-the-real-thing convention — the raw token exists only in
  // the emailed link and is never persisted anywhere.
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  // Which Dashboard widgets this user has chosen to show, and in what order — see
  // lib/dashboardWidgets.ts for the widget catalog and which roles can use each one. Null
  // means "no customization yet": show every widget this role is allowed, in the app's
  // default order. An empty array is a deliberate choice to hide everything, distinct from
  // null. Stored as JSON rather than a join table since it's just an ordered list of short
  // string keys — a table would only ever be queried and written one row (one user) at a time.
  dashboardLayout Json?

  createdProjects   Project[]       @relation("ProjectCreatedBy")
  assignedProjects  Project[]       @relation("ProjectAssignee")
  projectMemberships ProjectMember[]
  createdTasks      Task[]          @relation("TaskCreatedBy")
  assignedTasks     Task[]          @relation("TaskAssignee")
  comments          Comment[]
  attachments       Attachment[]
  timeEntries       TimeEntry[]
  activities        Activity[]
  createdProjectTypes ProjectType[]
  createdSubProjects  SubProject[]
  createdChecklistItems ChecklistItem[]
  createdTaskTemplates  TaskTemplate[]
  decidedAccessRequests AccessRequest[]
  followUps             FollowUp[]
  softwareLineGrants    UserSoftwareLineGrant[]
  accessRequestLineSubscriptions AccessRequestLineSubscription[]
  savedReports          SavedReport[]
  ticketFinderDevices   TicketFinderDevice[]
}

// One signed-in copy of the Ticket Finder desktop program. The program signs in once with
// the user's APM email and password and gets back a random key, kept encrypted on that PC;
// only its SHA-256 hash is stored here. The key works on /api/ticket-search and nothing
// else, stops working when the user is deactivated, and is revoked by signing out.
model TicketFinderDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  deviceName String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// Scopes which software lines' access-request emails an admin receives, when their
// accessRequestNotifyAllLines is false. Meaningless — and never populated — for non-admins;
// ignored entirely for an admin whose accessRequestNotifyAllLines is true.
model AccessRequestLineSubscription {
  userId         String
  softwareLineId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  softwareLine   SoftwareLine @relation(fields: [softwareLineId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([userId, softwareLineId])
}

// Grants a Project Lead or Member access to an additional software line beyond their home
// one — they switch into it the same way an admin switches lines, keeping their existing
// role's permissions. Admins need no grants (already unrestricted); Read Only stays locked
// to its home line (no UI ever creates a grant for that role).
model UserSoftwareLineGrant {
  userId         String
  softwareLineId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  softwareLine   SoftwareLine @relation(fields: [softwareLineId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([userId, softwareLineId])
}

model Project {
  id                     String      @id @default(cuid())
  name                   String
  description            String?
  teamSupportTicketNumber String?
  // The TeamSupport customer (organization) this project is for — picked from TeamSupport's own
  // list, name kept alongside so the page doesn't need a TeamSupport call to show it.
  teamSupportCustomerId   String?
  teamSupportCustomerName String?
  projectTypeId          String
  projectType            ProjectType @relation(fields: [projectTypeId], references: [id])
  softwareLineId         String
  softwareLine           SoftwareLine @relation(fields: [softwareLineId], references: [id])
  createdById            String
  createdBy              User        @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime    @default(now())
  archivedAt             DateTime?
  // Whoever is on the hook for the project as a whole — a lighter-weight alternative to
  // assigning every task individually when one person is handling the entire engagement.
  // Purely informational: it doesn't touch any task's own assigneeId, and isn't required to
  // equal the OWNER-role member (though it usually will). Assigning someone here adds them as
  // a project Member automatically if they aren't one already (see routes/projects.ts), same
  // as how being a project member doesn't require being assigned anything.
  assigneeId             String?
  assignee               User?       @relation("ProjectAssignee", fields: [assigneeId], references: [id])

  members    ProjectMember[]
  tasks      Task[]
  subProjects SubProject[]
  activities Activity[]
  attachments Attachment[]
  followUps  FollowUp[]
  contractLines ContractLine[]
}

// One billable services line from the project's contract (training, installation, project
// management...) — not license or maintenance lines, which have no time to log. `category` is one
// of the names in lib/contractCategories.ts; `hours` is what was sold (null when the contract
// doesn't say, e.g. a flat-fee PM line); hours used come from the time entries pointing here.
model ContractLine {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  category        String
  description     String
  hours           Float?
  amount          Float?
  createdAt       DateTime       @default(now())

  timeEntries TimeEntry[]
}

model ProjectType {
  id             String   @id @default(cuid())
  name           String
  description    String?
  active         Boolean  @default(true)
  softwareLineId String
  softwareLine   SoftwareLine @relation(fields: [softwareLineId], references: [id])
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  projects Project[]
  tasks    Task[]

  @@unique([softwareLineId, name])
}

model ChecklistItem {
  id             String   @id @default(cuid())
  name           String
  description    String?
  active         Boolean  @default(true)
  softwareLineId String
  softwareLine   SoftwareLine @relation(fields: [softwareLineId], references: [id])
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  subProjects   SubProject[]
  taskTemplates TaskTemplate[]
  contractLines ContractLine[]
}

model TaskTemplate {
  id              String        @id @default(cuid())
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  priority        TaskPriority  @default(MEDIUM)
  active          Boolean       @default(true)
  order           Int           @default(0)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
}

model SubProject {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id])
  name            String?
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  tasks Task[]
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Task {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProjectId  String
  subProject    SubProject  @relation(fields: [subProjectId], references: [id], onDelete: Cascade)
  projectTypeId String
  projectType   ProjectType @relation(fields: [projectTypeId], references: [id])
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  order       Int          @default(0)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  completedAt DateTime?
  naReason    String?
  createdById String
  createdBy   User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  comments    Comment[]
  attachments Attachment[]
  timeEntries TimeEntry[]
  activities  Activity[]
  followUps   FollowUp[]
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  // Snapshotted at post time from TeamSupport's "PS - ..." action type catalog, and whether
  // the synced note was posted Public or Private — display-only, doesn't affect anything.
  teamSupportActionType String?
  teamSupportIsPublic   Boolean  @default(false)
  createdAt DateTime @default(now())

  timeEntry TimeEntry?
  // Files attached to this comment when it was posted. They also carry the comment's taskId,
  // so they show in the task's Attachments card as well.
  attachments Attachment[]
}

model Attachment {
  id             String   @id @default(cuid())
  taskId         String?
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId      String?
  comment        Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId     String
  uploader       User     @relation(fields: [uploaderId], references: [id])
  storedFilename String
  originalName   String
  mimeType       String
  size           Int
  createdAt      DateTime @default(now())
}

model TimeEntry {
  id              String    @id @default(cuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  // Set when this entry came from logging hours alongside a comment, so the UI can show the
  // two as one line instead of two separate entries. Null for Start Timer/Stop entries, which
  // have no comment of their own.
  commentId       String?   @unique
  comment         Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)
  // The contract line this time counts against, if any (chosen on the comment form, or matched
  // automatically from the task's product + the comment's action type).
  contractLineId  String?
  contractLine    ContractLine? @relation(fields: [contractLineId], references: [id], onDelete: SetNull)
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  note            String?
  createdAt       DateTime  @default(now())
}

// A calendar reminder to check back on a task, or on a project as a whole — deliberately not
// a Task itself, so it never shows up as an open task in reports, dashboard counts, or a
// sub-project's board. Exactly one of taskId/projectId is set, never both and never neither —
// enforced at the application level (routes/tasks.ts's comment form for task-linked ones,
// routes/projects.ts's own follow-up route for project-level ones), matching how Attachment
// already does the same optional-either-parent pattern in this schema.
model FollowUp {
  id        String    @id @default(cuid())
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  dueDate   DateTime
  createdAt DateTime  @default(now())
  // Set once the "your follow-up is due" email has actually been sent — not a boolean,
  // matching this schema's existing convention for "did this happen" columns (Task.completedAt,
  // Project.archivedAt, AccessRequest.decidedAt).
  remindedAt DateTime?
  // Set when whoever scheduled it (or an admin) marks it done — shows crossed out on the
  // calendar from then on, and stops the daily digest from ever mentioning it, but the row
  // itself is kept rather than deleted so the calendar still shows it happened.
  completedAt DateTime?
}

// A named, reusable task report — the columns to show, the filters and sort to run it with.
// Scoped to a software line: every admin in the line can see and run any report saved in it
// (listed together in a shared "Saved reports" section, like Project Types and Products are a
// shared catalog), but editing or deleting one is restricted to whoever created it — enforced
// in routes/reports.ts, not here. columns/filters are stored as JSON rather than individual
// nullable columns — the report builder's column and filter set is expected to grow, and a
// JSON blob means adding one never needs its own migration; lib/reportBuilder.ts is the single
// place that knows their shape.
model SavedReport {
  id             String   @id @default(cuid())
  name           String
  description    String?
  softwareLineId String
  softwareLine   SoftwareLine @relation(fields: [softwareLineId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  columns        Json
  filters        Json
  sortBy         String?
  sortDir        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Durable "has this scheduled job already run today" marker for the daily notifications
// job (see lib/scheduler.ts). The app restarts on every deploy, so an in-memory flag would
// let a deploy during the send window double-fire the digest — this row is claimed with an
// atomic updateMany instead, which is also safe if the App Service is ever scaled to more
// than one instance.
model JobRun {
  name      String   @id
  lastRunOn DateTime
  updatedAt DateTime @updatedAt
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  message   String
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  // Captured at log time and never derived through projectId/taskId, so a deleted
  // project's or task's history stays queryable by line even after those FKs go null.
  softwareLineId String
  softwareLine   SoftwareLine @relation(fields: [softwareLineId], references: [id])
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
}

model AccessRequest {
  id             String              @id @default(cuid())
  name           String
  email          String
  message        String?
  status         AccessRequestStatus @default(PENDING)
  softwareLineId String
  softwareLine   SoftwareLine        @relation(fields: [softwareLineId], references: [id])
  createdAt      DateTime            @default(now())
  decidedAt      DateTime?
  decidedById    String?
  decidedBy      User?               @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status])
}

// Short step-by-step fixes for common support problems, written by support leads in APM's
// admin page. Ticket Finder shows the active ones that match a ticket's title (and product)
// and feeds them to its AI research as evidence.
model FixPlaybook {
  id            String   @id @default(cuid())
  title         String
  // Words or phrases looked for in a ticket's title (whole words, any case).
  matchPhrases  String[]
  // Product line (lib/fixPlaybooks.ts PRODUCT_LINES id, e.g. "trio"), worked out from the
  // ticket's product name; null = every line.
  productLine   String?
  // Only for tickets whose product name contains one of these; empty = any product.
  products      String[]
  // One step per line.
  steps         String   @default("")
  // Off until a lead has checked the steps; only active playbooks reach Ticket Finder.
  active        Boolean  @default(false)
  // The closed tickets an AI draft was based on, for the lead to check.
  sourceTickets String[]
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
